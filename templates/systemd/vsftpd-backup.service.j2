[Unit]
Description=FTP backup
After=vsftpd.service
After=backup.mount
Requires=vsftpd.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/mkdir -p /backup/vsftpd
ExecStart=/bin/sh -c '/usr/bin/tar cjvf /backup/vsftpd/vsftpd-`/usr/bin/date -Iminutes`.tar.bz2 --ignore-failed-read /etc/vsftpd* /home/{{ users | map(attribute="name") | join('/ftp /home/') }}/ftp && /usr/bin/find /backup/vsftpd/ -mindepth 1 -maxdepth 1 -mtime +7 -exec /usr/bin/rm -rf {} +'
StandardOutput=journal

[Install]
WantedBy=multi-user.target
