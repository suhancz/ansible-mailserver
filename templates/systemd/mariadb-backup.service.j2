[Unit]
Description=MariaDB backup
After=mariadb.service
After=backup.mount
Requires=mariadb.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/mkdir -p /backup/mariadb
ExecStart=/bin/sh -c '/usr/bin/mkdir -p /backup/mariadb/`/usr/bin/date -Iminutes` && /usr/bin/mariabackup --backup --target-dir=/backup/mariadb/`/usr/bin/date -Iminutes` --safe-slave-backup --user=mariabackup --password={{ mariabackup_password }} && /usr/bin/find /backup/mariadb/ -mindepth 1 -maxdepth 1 -mtime +7 -exec /usr/bin/rm -rf {} +'
StandardOutput=journal

[Install]
WantedBy=multi-user.target
