[Unit]
Description=LDAP backup
After=dirsrv@{{ mailserver_hostname }}.service
After=backup.mount
Requires=dirsrv@{{ mailserver_hostname }}.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/mkdir -p /backup/ldap
ExecStart=/bin/sh -c "/usr/sbin/dsconf {{ mailserver_hostname }} backup create && /usr/bin/tar cjvf /backup/ldap/LDAP_backup.`/usr/sbin/dsctl {{ mailserver_hostname }} backups|/usr/bin/tail -n1|/usr/bin/awk '{print $2}'|/usr/bin/awk -F/ '{print $NF}'`.tar.bz2 `/usr/sbin/dsctl {{ mailserver_hostname }} backups|/usr/bin/tail -n1|/usr/bin/awk '{print $2}'` && /usr/bin/find /backup/ldap/ -mindepth 1 -maxdepth 1 -mtime +7 -exec /usr/bin/rm -rf {} +"
StandardOutput=journal

[Install]
WantedBy=multi-user.target
