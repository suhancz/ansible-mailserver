[Unit]
Description=LDAP backup
After="dirsrv@{{ mailserver_domain.split('.')[0] }}.service"
After=backup.mount
Requires="dirsrv@{{ mailserver_domain.split('.')[0] }}.service"

[Service]
Type=oneshot
ExecStart=/bin/sh -c "/usr/sbin/dsconf {{ mailserver_domain.split('.')[0] }} backup create && /usr/bin/tar cjvf /backup/ldap/LDAP_backup.`/usr/sbin/dsctl {{ mailserver_domain.split('.')[0] }} backups|/usr/bin/tail -n1|/usr/bin/awk '{print $2}'|/usr/bin/awk -F/ '{print $NF}'`.tar.bz2 `/usr/sbin/dsctl {{ mailserver_domain.split('.')[0] }} backups|/usr/bin/tail -n1|/usr/bin/awk '{print $2}'` && /usr/bin/find /backup/ldap/ -mindepth 1 -maxdepth 1 -mtime +7 -exec /usr/bin/rm -rf {} \;"
StandardOutput=journal

[Install]
WantedBy=multi-user.target
