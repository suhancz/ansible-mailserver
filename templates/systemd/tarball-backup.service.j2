[Unit]
Description={{ item.name }} backup
{% if item.service is defined and item.service %}
After={{ item.name }}.service
After=backup.mount
Requires={{ item.name }}.service
{% endif %}

[Service]
Type=oneshot
ExecStartPre=/usr/bin/mkdir -p /backup/{{ item.name }}
ExecStart=/bin/sh -c '/usr/bin/tar cjvf /backup/{{ item.name }}/{{ item.name }}-`/usr/bin/date -Iminutes`.tar.bz2 --ignore-failed-read {{ item.paths|join("* ") }}* && /usr/bin/find /backup/{{ item.name }}/ -mindepth 1 -maxdepth 1 -mtime +7 -exec /usr/bin/rm -rf {} +'
StandardOutput=journal

[Install]
WantedBy=multi-user.target
